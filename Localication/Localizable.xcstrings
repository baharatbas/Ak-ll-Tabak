    "Aralıklı Oruç" : {
      "comment" : "A title for the page.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intermittent Fasting"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeûne intermittent"
          }
