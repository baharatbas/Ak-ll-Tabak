    "Vegan Diyet" : {
      "comment" : "A title of the page.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vegan Diet"
          }
        },
        "fr" : {
          "stringUnit" : {
