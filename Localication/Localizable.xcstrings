    "Düşük Karbonhidrat" : {
      "comment" : "The title of the view.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Low Carbohydrate"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faible en glucides"
          }
        },
        "tr" : {
