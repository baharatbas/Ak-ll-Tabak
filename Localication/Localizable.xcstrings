    },
    "MIND diyeti, beyin sağlığını korumayı amaçlayan Akdeniz ve DASH diyetlerinin birleşimidir.\n\nAlzheimer riskini azaltmaya yardımcı olabilir." : {
      "comment" : "MIND diet description.",
      "extractionState" : "stale",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The MIND diet is a combination of the Mediterranean and DASH diets, aimed at protecting brain health.\n\nIt may help reduce the risk of Alzheimer's disease."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le régime MIND est une combinaison des régimes méditerranéen et DASH, visant à protéger la santé cérébrale.\n\nIl pourrait contribuer à réduire le risque de maladie d'Alzheimer."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MIND diyeti, Akdeniz ve DASH diyetlerinin birleşiminden oluşmakta olup beyin sağlığını korumayı amaçlamaktadır.\n\nAlzheimer hastalığı riskini azaltmaya yardımcı olabilir."
          }
        }
      }
    },
